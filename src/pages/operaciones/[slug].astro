---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPage from "../../components/HeroPage.astro";

// 1. Data Definition (Simulated Data Source)
// In a real scenario, this could be a separate JSON file or Astro content collection.
const services = [
    {
        slug: "obras-civiles",
        title: "Obras Civiles",
        descriptionHero:
            "Infraestructura robusta con los más altos estándares.",
        descriptionPage: `
            <p>En <strong>INACONS</strong>, la ejecución de obras civiles es uno de nuestros pilares fundamentales. Nos especializamos en la construcción de infraestructuras que combinan durabilidad, funcionalidad y estética, adaptándonos a los requerimientos específicos de cada cliente y terreno.</p>
            <p>Nuestro equipo multidisciplinario gestiona cada etapa del proyecto, desde la planificación inicial y el movimiento de tierras hasta la cimentación y los acabados finales, garantizando el cumplimiento de los plazos y la calidad en cada detalle.</p>
            <ul>
                <li>Edificaciones residenciales y corporativas.</li>
                <li>Cimentaciones profundas y estructuras complejas.</li>
                <li>Habilitaciones urbanas.</li>
            </ul>
        `,
        bannerImage: "/images/imagenes/image_obra_civiles.webp",
        portfolioFile: "/pdf/3 -PORTAFOLIO_OBRAS CIVILES.pdf",
        relatedProjects: [
            {
                title: "Complejo Residencial 'Los Álamos'",
                slug: "complejo-residencial-alamos",
            },
            {
                title: "Edificio Corporativo Inceptio",
                slug: "edificio-inceptio",
            },
        ],
    },
    {
        slug: "infraestructura",
        title: "Infraestructura",
        descriptionHero:
            "Conectando regiones con ingeniería de gran envergadura.",
        descriptionPage: `
            <p>Desarrollamos proyectos de infraestructura vial y logística que impulsan el desarrollo económico y social. Nuestra experiencia abarca la construcción de carreteras, puentes y accesos en geografías desafiantes.</p>
            <p>Utilizamos tecnología de punta y maquinaria especializada para asegurar la eficiencia y sostenibilidad de nuestras obras, cumpliendo con todas las normativas técnicas y ambientales vigentes.</p>
        `,
        bannerImage: "/images/imagenes/image_infraestructura.webp",
        portfolioFile: "/pdf/1 -PORTAFOLIO MOV. TIERRAS.pdf",
        relatedProjects: [
            {
                title: "Carretera Interoceánica Tramo 4",
                slug: "carretera-interoceanica-4",
            },
            { title: "Puente Vehicular Santa Rosa", slug: "puente-santa-rosa" },
        ],
    },
    {
        slug: "electromecanica",
        title: "Electromecánica",
        descriptionHero: "Soluciones integrales en energía y automatización.",
        descriptionPage: `
            <p>Ofrecemos servicios especializados en montaje electromecánico, instalación de subestaciones y sistemas de automatización industrial. Garantizamos la operatividad y seguridad de sus activos críticos.</p>
        `,
        bannerImage: "/images/imagenes/image_electromecanica.webp",
        portfolioFile: "/pdf/2 -PORTAFOLIO_SERV.ELECTROMECANICO.pdf",
        relatedProjects: [
            {
                title: "Subestación Eléctrica Moyobamba",
                slug: "subestacion-moyobamba",
            },
        ],
    },
    {
        slug: "paisajismo",
        title: "Paisajismo",
        descriptionHero: "Integrando la naturaleza en cada proyecto.",
        descriptionPage: `
            <p>Transformamos espacios mediante el diseño y ejecución de proyectos paisajísticos que armonizan con el entorno. Desde parques públicos hasta áreas verdes corporativas.</p>
        `,
        bannerImage: "/images/imagenes/image_paisajismo.webp",
        portfolioFile: "/pdf/5 -PORTAFOLIO_PAISAJISMO.pdf",
        relatedProjects: [
            { title: "Parque Lineal del Río", slug: "parque-lineal-rio" },
        ],
    },
    {
        slug: "mineria",
        title: "Minería",
        descriptionHero: "Servicios especializados para el sector extractivo.",
        descriptionPage: `
            <p>Proveemos soporte integral a la minería con la construcción de campamentos, plantas de tratamiento y obras civiles en alta montaña, siempre bajo estrictos protocolos de seguridad.</p>
        `,
        bannerImage: "/images/imagenes/image_mineria.webp",
        portfolioFile: "", // Pending specific portfolio
        relatedProjects: [
            {
                title: "Planta de Tratamiento Mina Justa",
                slug: "planta-mina-justa",
            },
        ],
    },
    {
        slug: "consultoria",
        title: "Consultoría",
        descriptionHero:
            "Asesoría técnica experta para decisiones estratégicas.",
        descriptionPage: `
            <p>Brindamos servicios de consultoría en ingeniería, gestión de proyectos y supervisión de obras, asegurando la viabilidad técnica y económica de sus inversiones.</p>
        `,
        bannerImage: "/images/imagenes/image_consultoría.webp",
        portfolioFile: "/pdf/4 -PORTAFOLIO_DISEÑO.pdf",
        relatedProjects: [],
    },
];

// 2. getStaticPaths Implementation
export async function getStaticPaths() {
    const servicesData = [
        { slug: "obras-civiles" },
        { slug: "infraestructura" },
        { slug: "electromecanica" },
        { slug: "paisajismo" },
        { slug: "mineria" },
        { slug: "consultoria" },
    ];

    return servicesData.map(({ slug }) => {
        return {
            params: { slug },
        };
    });
}

// 3. Get Current Service Data
const { slug } = Astro.params;
const currentService = services.find((s) => s.slug === slug);

// Handle 404 (Optional safety check, though getStaticPaths usually handles valid ones)
if (!currentService) {
    return Astro.redirect("/404");
}

// 4. Get Other Services for Aside
const otherServices = services.filter((s) => s.slug !== slug);

// Icons
const iconPdf = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`;
const iconArrowRight = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<BaseLayout theme="light">
    <!-- Hero Component -->
    <HeroPage
        variant="project"
        title={currentService.title}
        subtitle="SOLUCIONES ESPECIALIZADAS"
        content={currentService.descriptionHero}
        background={{
            type: "image",
            src: currentService.bannerImage,
            alt: currentService.title,
        }}
        breadcrumbs={[
            { label: "Inicio", url: "/" },
            { label: "Operaciones", url: "/operaciones" },
            { label: currentService.title },
        ]}
    />

    <!-- Main Content Layout -->
    <div class="service-container">
        <div class="service-layout">
            <!-- Left Column: Service Information -->
            <main class="service-content">
                <header class="content-header">
                    <h1 class="page-title">{currentService.title}</h1>
                    <div class="title-underline"></div>
                </header>

                <div
                    class="description-block"
                    set:html={currentService.descriptionPage}
                />

                {
                    currentService.relatedProjects.length > 0 && (
                        <div class="related-projects">
                            <h2 class="related-title">Proyectos destacados</h2>
                            <ul class="projects-list">
                                {currentService.relatedProjects.map(
                                    (project) => (
                                        <li>
                                            <a
                                                href={`/proyectos#${project.slug}`}
                                                class="project-link"
                                            >
                                                <span class="project-name">
                                                    {project.title}
                                                </span>
                                                <span
                                                    class="link-icon"
                                                    set:html={iconArrowRight}
                                                />
                                            </a>
                                        </li>
                                    ),
                                )}
                            </ul>
                        </div>
                    )
                }
            </main>

            <!-- Right Column: Aside & Navigation -->
            <aside class="service-aside">
                <!-- Card 1: Downloads -->
                <div class="aside-card downloads-card">
                    <h3 class="aside-title">Recursos</h3>
                    <div class="download-links">
                        <a
                            href="/pdf/brochure_inacons.pdf"
                            target="_blank"
                            class="btn-download"
                        >
                            <span class="btn-icon" set:html={iconPdf} />
                            <span class="btn-text">Brochure Corporativo</span>
                        </a>
                        <a
                            href={currentService.portfolioFile}
                            target="_blank"
                            class="btn-download secondary"
                        >
                            <span class="btn-icon" set:html={iconPdf} />
                            <span class="btn-text">Portafolio Específico</span>
                        </a>
                    </div>
                </div>

                <!-- Card 2: Other Services -->
                <div class="aside-card nav-card">
                    <h3 class="aside-title">Otras Operaciones</h3>
                    <nav class="services-nav">
                        <ul>
                            {
                                otherServices.map((svc) => (
                                    <li>
                                        <a
                                            href={`/operaciones/${svc.slug}`}
                                            class="nav-link"
                                        >
                                            {svc.title}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </nav>
                </div>
            </aside>
        </div>
    </div>
</BaseLayout>

<style>
    /* PAGE LAYOUT */
    .service-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 6rem 1.5rem; /* Increased top padding for better breathing room */
        background-color: var(--background-default);
    }

    .service-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;
    }

    @media (min-width: 992px) {
        .service-layout {
            grid-template-columns: 1fr 340px; /* Editorial proportions: Content + Fixed Sidebar */
            gap: 6rem;
        }
    }

    /* LEFT COLUMN: CONTENT */
    .content-header {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 1rem;
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .title-underline {
        width: 60px;
        height: 4px;
        background-color: var(--brand-accent);
    }

    .description-block {
        font-size: 1.125rem;
        line-height: 1.8; /* Better readability */
        color: var(--text-secondary);
        margin-bottom: 4rem;
    }

    /* Use :global because HTML is inserted via set:html */
    .description-block :global(p) {
        margin-bottom: 1.5rem;
    }

    .description-block :global(strong) {
        color: var(--text-primary);
        font-weight: 600;
    }

    .description-block :global(ul) {
        margin-bottom: 2rem;
        padding-left: 1.25rem;
        list-style: none; /* Custom bullets */
    }

    .description-block :global(li) {
        margin-bottom: 0.75rem;
        position: relative;
        padding-left: 1.5rem;
    }

    .description-block :global(li::before) {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--brand-accent);
        font-size: 1.2em;
        line-height: 1;
        top: 2px;
    }

    /* Related Projects */
    .related-projects {
        margin-top: 4rem;
        padding-top: 3rem;
        border-top: 1px solid var(--color-gray-200);
    }

    .related-title {
        font-size: 1.25rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1.5rem;
        color: var(--text-primary);
    }

    .projects-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .projects-list li {
        border-bottom: 1px solid var(--color-gray-100);
    }

    .projects-list li:last-child {
        border-bottom: none;
    }

    .project-link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0.5rem;
        text-decoration: none;
        color: var(--text-secondary);
        transition: all 0.2s ease;
        border-radius: 4px;
    }

    .project-link:hover {
        color: var(--brand);
        background-color: var(--color-gray-50);
        padding-left: 1rem;
    }

    .project-name {
        font-weight: 500;
    }

    .link-icon {
        color: var(--brand-accent);
        transition: transform 0.3s ease;
        opacity: 0.7;
    }

    .project-link:hover .link-icon {
        transform: translateX(4px);
        opacity: 1;
    }

    /* RIGHT COLUMN: ASIDE */
    .service-aside {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .aside-card {
        background-color: var(--background-surface);
        border: 1px solid var(--color-gray-200);
        border-radius: var(--radius-card);
        padding: 2rem;
        box-shadow: var(--shadow-card);
    }

    .aside-title {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border-bottom: 1px solid var(--color-gray-200);
        padding-bottom: 1rem;
    }

    /* Downloads */
    .download-links {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .btn-download {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background-color: var(--brand); /* Brand Blue */
        color: #fff;
        text-decoration: none;
        border-radius: var(--radius-button);
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.2s ease;
        line-height: 1.2;
    }

    .btn-download:hover {
        background-color: var(--brand-hover);
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .btn-download.secondary {
        background-color: transparent;
        color: var(--text-primary);
        border: 1px solid var(--color-gray-300);
    }

    .btn-download.secondary:hover {
        background-color: var(--color-gray-50);
        border-color: var(--brand);
        color: var(--brand);
    }

    .btn-icon {
        color: inherit;
        opacity: 0.9;
    }

    .btn-download.secondary .btn-icon {
        color: var(--brand-accent);
    }

    /* Services Nav */
    .services-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .nav-link {
        display: block;
        padding: 0.75rem 0;
        color: var(--text-secondary);
        text-decoration: none;
        border-bottom: 1px solid var(--color-gray-100);
        transition: all 0.2s ease;
        font-size: 0.95rem;
    }

    .nav-link:hover {
        color: var(--brand);
        padding-left: 0.5rem;
        border-bottom-color: var(--brand-accent);
    }

    .nav-link.active {
        /* If we were marking active state */
        font-weight: 600;
        color: var(--brand);
    }

    .services-nav li:last-child .nav-link {
        border-bottom: none;
    }
</style>
