---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroPage from "../components/HeroPage.astro";
import ContentSection from "../components/ContentSection.astro";
import ValueCarousel from "../components/ValueCarousel.astro";
import ClientsCarousel from "../components/ClientsCarousel.astro";
---

<BaseLayout>
    <HeroPage
        variant="home"
        title={`CONSTRUIMOS CONFIANZA \n INNOVAMOS ESPACIOS \n TRASCENDEMOS JUNTOS`}
        subtitle="Con más de 15 años de experiencia, INACONS es líder en construcción e ingeniería en Perú."
        content="Conoce nuestra historia y valores."
        background={{
            type: "video",
            src: "/videos/hero.mp4",
            alt: "Hero Video",
            poster: "/images/imagenes/image_heroprincipal.webp",
        }}
        indicators={[
            { label: "experiencia", value: "15 años" },
            { label: "construidos", value: "150KM2" },
            { label: "inversion", value: "100MM" },
            { label: "profesionales", value: "+100" },
        ]}
    />

    <!-- SECCIÓN 1: Bienvenida -->
    <ContentSection
        id="bienvenida"
        subtitle="Bienvenidos a INACONS"
        title="Ingeniería con Propósito, Construcción con Legado"
        description="Con más de 15 años impulsando el desarrollo del Perú, hemos perfeccionado una metodología que une innovación, precisión técnica y un compromiso inquebrantable con cada obra. No solo construimos infraestructura: materializamos confianza. Ejecutamos proyectos de alta complejidad con excelencia, cumplimiento y una gestión que garantiza resultados."
        cta={{ label: "Descubra nuestra historia", href: "/nosotros" }}
        image={{
            src: "/images/imagenes/home_about.webp",
            alt: "Equipo INACONS en obra",
        }}
        imagePosition="right"
        mobileImagePosition="top"
    />

    <!-- SECCIÓN 2: Experiencia Regional -->
    <ContentSection
        id="experiencia"
        subtitle="Capacidad Nacional"
        title="Presencia que Genera Resultados en Todo el Perú"
        description="Operamos más de 30 frentes de trabajo simultáneos en costa, sierra y selva. Esta cobertura nos permite movilizar logística especializada y talento local donde sea necesario, asegurando continuidad operativa y éxito en cada proyecto, sin importar el desafío geográfico."
        image={{
            src: "/images/imagenes/peru2.svg" /* Using SVG map if suitable, or hero_poster */,
            alt: "Proyectos en todo el Perú",
        }}
        imagePosition="left"
        mobileImagePosition="bottom"
    />

    <!-- SECCIÓN 3: Carrousel de Valor -->
    <ValueCarousel
        slides={[
            {
                title: "Servicios Integrales de Ingeniería y Construcción",
                description:
                    "Transformamos los desafíos técnicos y logísticos más exigentes en soluciones eficientes y viables. Nuestro portafolio abarca desde consultoría estratégica hasta ejecución llave en mano, mediante metodologías innovadoras que garantizan el éxito de cada proyecto.",
                cta: {
                    label: "Explore nuestros servicios",
                    href: "/operaciones",
                },
                image: {
                    src: "/images/imagenes/image_obra_civiles.webp",
                    alt: "Servicios de ingeniería",
                },
            },
            {
                title: "Alianzas y Certificaciones de Clase Mundial",
                description:
                    "Trabajamos bajo estándares globales, respaldados por certificaciones internacionales y alianzas estratégicas con líderes del sector. Este ecosistema nos permite operar con los más altos niveles de calidad, seguridad e integridad.",
                cta: {
                    label: "Conozca nuestras certificaciones",
                    href: "/certificacion",
                },
                image: {
                    src: "/images/imagenes/image_consultoría.webp",
                    alt: "Certificaciones internacionales",
                },
            },
            {
                title: "Compromiso con un Futuro Sostenible",
                description:
                    "Integramos sostenibilidad y gestión social en el núcleo de nuestros proyectos. Impulsamos prácticas responsables que protegen el entorno, fortalecen a las comunidades y generan valor compartido en cada operación.",
                cta: {
                    label: "Vea nuestro compromiso",
                    href: "/sostenibilidad",
                },
                image: {
                    src: "/images/imagenes/sostenibilidad.png",
                    alt: "Sostenibilidad ambiental",
                },
            },
        ]}
    />

    <!-- SECCIÓN 4: Clientes / Casos de Éxito -->
    <ClientsCarousel
        subtitle="Casos de Éxito"
        title="Aliados Estratégicos que Construyen el Perú con Nosotros"
        description="Colaboramos con organizaciones que comparten nuestra visión de excelencia. Nuestras alianzas están basadas en confianza, innovación aplicada y una gestión rigurosa que eleva los estándares de la industria en cada obra que ejecutamos."
    />
</BaseLayout>
