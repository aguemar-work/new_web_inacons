---
interface Props {
    title: string;
    description: string;
    fileUrl: string;
    icon?: string;
}

const { title, description, fileUrl, icon } = Astro.props;

// Default Icon (PDF/Document)
const defaultIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`;
---

<article class="doc-card">
    <div class="doc-icon">
        <div set:html={icon || defaultIcon} />
    </div>
    <div class="doc-content">
        <h3 class="doc-title">{title}</h3>
        <p class="doc-desc">{description}</p>
    </div>
    <a
        href={fileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="doc-cta"
        aria-label={`Ver documento: ${title}`}
    >
        <span>Ver documento</span>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="arrow"
            ><line x1="7" y1="17" x2="17" y2="7"></line><polyline
                points="7 7 17 7 17 17"></polyline></svg
        >
    </a>
</article>

<style>
    .doc-card {
        background-color: #fff;
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .doc-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
        border-color: var(--color-brand-accent, #dba618);
    }

    .doc-icon {
        color: var(--color-brand-accent, #dba618);
        margin-bottom: 1.5rem;
        transition: transform 0.3s ease;
    }

    .doc-icon :global(svg) {
        stroke-width: 1.5;
    }

    .doc-card:hover .doc-icon {
        transform: scale(1.1);
    }

    .doc-content {
        flex-grow: 1;
        margin-bottom: 2rem;
    }

    .doc-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: var(--color-brand-primary, #1a1a1a);
        line-height: 1.3;
    }

    .doc-desc {
        font-size: 0.95rem;
        color: var(--color-text-body, #666);
        line-height: 1.6;
    }

    .doc-cta {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 0.75rem 1rem;
        background-color: #f8f9fa;
        color: var(--color-brand-primary, #1a1a1a);
        text-decoration: none;
        font-weight: 600;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .doc-cta .arrow {
        transition: transform 0.3s ease;
    }

    .doc-cta:hover {
        background-color: var(--color-brand-primary, #1a1a1a);
        color: #fff;
    }

    .doc-cta:hover .arrow {
        transform: translate(2px, -2px);
    }
</style>
