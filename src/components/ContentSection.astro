---
interface Props {
    subtitle?: string;
    title: string;
    description: string;
    image: {
        src: string;
        alt: string;
    };
    cta?: {
        label: string;
        href: string;
    };
    imagePosition?: "left" | "right";
    mobileImagePosition?: "top" | "bottom";
    id?: string;
}

const {
    subtitle,
    title,
    description,
    image,
    cta,
    imagePosition = "right",
    mobileImagePosition = "top",
    id,
} = Astro.props;

// Default button for dark background is accent
const buttonClass = "btn-accent";
---

<section id={id} class="section">
    <div class="container section__grid">
        <!-- Image Wrapper -->
        <div
            class="section__image-wrapper reveal-on-scroll"
            data-desktop-pos={imagePosition}
            data-mobile-pos={mobileImagePosition}
        >
            <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                class="section__image"
            />
        </div>

        <!-- Content Wrapper -->
        <div class="section__content reveal-on-scroll reveal-delay-1">
            <div class="section__header">
                {subtitle && <span class="section__subtitle">{subtitle}</span>}
                <h2 class="section__title">{title}</h2>
            </div>
            <p class="section__description" set:html={description} />
            {
                cta && (
                    <a href={cta.href} class={`btn ${buttonClass}`}>
                        {cta.label}
                    </a>
                )
            }
        </div>
    </div>
</section>

<style>
    .section {
        padding: 4rem 0;
        /* Background is handled by parent/global theme */
    }

    .section__grid {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    /* --- Image Logic --- */
    .section__image-wrapper {
        width: 100%;
        border-radius: var(--radius-md, 8px);
        overflow: hidden;
        position: relative;
        aspect-ratio: 16/9;
        box-shadow: var(--shadow-card);
    }

    .section__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .section__image-wrapper:hover .section__image {
        transform: scale(1.05);
    }

    .section__image-wrapper[data-mobile-pos="bottom"] {
        order: 2;
    }
    .section__image-wrapper[data-mobile-pos="top"] {
        order: 0;
    }

    /* --- Content Styling --- */
    .section__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.5rem;
    }

    .section__subtitle {
        display: block;
        font-size: 0.875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-brand-accent, #d9822b);
        margin-bottom: 0.5rem;
    }

    .section__title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.1;
        font-weight: 800;
        color: var(--text-primary);
    }

    .section__description {
        font-size: 1.125rem;
        line-height: 1.6;
        color: var(--text-secondary);
    }

    /* Remove old btn-primary style as we use global classes now */

    /* --- Desktop (lg) --- */
    @media (min-width: 1024px) {
        .section {
            padding: 6rem 0;
        }

        .section__grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
        }

        .section__image-wrapper[data-desktop-pos="right"] {
            order: 1;
        }
        .section__image-wrapper[data-desktop-pos="left"] {
            order: 0;
        }

        .section__image-wrapper {
            aspect-ratio: 4/3;
        }
    }
</style>
