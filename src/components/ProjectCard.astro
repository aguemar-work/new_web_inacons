---
interface Props {
    title: string;
    category: string;
    image: string;
    duration: string;
    amount: string;
    location: string;
    link?: string;
    slug?: string;
}

const { title, category, image, duration, amount, location, link, slug } =
    Astro.props;

const finalLink = link || (slug ? `/proyectos/${slug}` : "#");

// Iconic SVGs
const iconClock = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`;
const iconCoin = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path></svg>`;
const iconMap = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>`;
---

<article class="project-card" data-category={category}>
    <div class="card-image-wrapper">
        <img
            src={image}
            alt={`Foto del proyecto ${title}`}
            loading="lazy"
            class="card-bg"
        />
        <div class="card-overlay"></div>
        <div class="card-badge">{category}</div>
    </div>

    <div class="card-content">
        <h3 class="card-title">{title}</h3>

        <div class="card-meta">
            <div class="meta-item" title="Plazo de ejecución">
                <span class="meta-icon" set:html={iconClock} />
                <span class="meta-text">{duration}</span>
            </div>
            <div class="meta-item" title="Monto de inversión">
                <span class="meta-icon" set:html={iconCoin} />
                <span class="meta-text">{amount}</span>
            </div>
            <div class="meta-item" title="Ubicación">
                <span class="meta-icon" set:html={iconMap} />
                <span class="meta-text">{location}</span>
            </div>
        </div>

        <a
            href={finalLink}
            class="card-cta"
            aria-label={`Ver proyecto ${title}`}
        >
            Ver proyecto
            <span class="arrow">→</span>
        </a>
    </div>
</article>

<style>
    .project-card {
        position: relative;
        height: 480px;
        border-radius: 12px;
        overflow: hidden;
        background-color: #000;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
        group: true;
    }

    .project-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    /* Background & Overlay */
    .card-image-wrapper {
        position: absolute;
        inset: 0;
        z-index: 1;
        overflow: hidden;
    }

    .card-bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .project-card:hover .card-bg {
        transform: scale(1.08);
    }

    .card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.1) 0%,
            rgba(0, 0, 0, 0.4) 40%,
            rgba(0, 0, 0, 0.9) 100%
        );
        transition: opacity 0.3s ease;
    }

    .project-card:hover .card-overlay {
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.1) 0%,
            rgba(0, 0, 0, 0.5) 40%,
            rgba(0, 0, 0, 0.95) 100%
        );
    }

    /* Badge */
    .card-badge {
        position: absolute;
        top: 1.5rem;
        left: 1.5rem;
        background-color: var(
            --color-brand-primary,
            #1a1a1a
        ); /* Adjust if needed */
        color: #fff;
        padding: 0.35rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 4px;
        z-index: 10;
        letter-spacing: 0.05em;
        backdrop-filter: blur(4px); /* Glassmorphism hint */
        background: rgba(26, 26, 26, 0.85); /* Semi-transparent override */
    }

    /* Content */
    .card-content {
        position: relative;
        z-index: 2;
        padding: 2rem;
        width: 100%;
        color: #fff;
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        line-height: 1.2;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    }

    .card-meta {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        opacity: 0.9;
    }

    .meta-icon {
        color: var(--color-brand-accent, #dba618);
        display: flex;
        align-items: center;
    }

    .meta-text {
        color: #e0e0e0;
        font-weight: 500;
    }

    /* CTA */
    .card-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-brand-accent, #dba618);
        text-decoration: none;
        letter-spacing: 0.05em;
        transition: color 0.3s ease;
    }

    .card-cta .arrow {
        transition: transform 0.3s ease;
    }

    .card-cta:hover {
        color: #fff;
    }

    .card-cta:hover .arrow {
        transform: translateX(5px);
    }
</style>
